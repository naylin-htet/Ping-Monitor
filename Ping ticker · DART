// lib/widgets/ping_ticker.dart
// Scrolling list of recent ping results with colour-coded badges.

import 'package:flutter/material.dart';
import 'package:intl/intl.dart';
import '../models/models.dart';
import '../utils/app_theme.dart';

class PingTicker extends StatefulWidget {
  final List<PingResult> results;
  final int maxVisible;

  const PingTicker({
    super.key,
    required this.results,
    this.maxVisible = 7,
  });

  @override
  State<PingTicker> createState() => _PingTickerState();
}

class _PingTickerState extends State<PingTicker> {
  final _scroll = ScrollController();

  @override
  void didUpdateWidget(PingTicker old) {
    super.didUpdateWidget(old);
    if (widget.results.length != old.results.length) {
      WidgetsBinding.instance.addPostFrameCallback((_) {
        if (_scroll.hasClients) {
          _scroll.animateTo(
            _scroll.position.maxScrollExtent,
            duration: const Duration(milliseconds: 180),
            curve: Curves.easeOut,
          );
        }
      });
    }
  }

  @override
  void dispose() {
    _scroll.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    final isDark = Theme.of(context).brightness == Brightness.dark;
    final all = widget.results;
    final visible = all.length > widget.maxVisible
        ? all.sublist(all.length - widget.maxVisible)
        : all;

    return Container(
      decoration: BoxDecoration(
        color: isDark ? AppColors.bgCard : AppColors.bgLightCard,
        borderRadius: BorderRadius.circular(14),
        border: Border.all(
          color: isDark ? AppColors.bgCardBorder : AppColors.bgLightBorder,
        ),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // Header
          Padding(
            padding: const EdgeInsets.fromLTRB(14, 12, 14, 8),
            child: Row(
              children: [
                Icon(Icons.receipt_long_rounded,
                    size: 13,
                    color: isDark
                        ? AppColors.textSecondary
                        : AppColors.textDarkSub),
                const SizedBox(width: 6),
                Text('RECENT PINGS',
                    style: TextStyle(
                      fontSize: 10,
                      fontWeight: FontWeight.w700,
                      letterSpacing: 1.2,
                      color: isDark
                          ? AppColors.textSecondary
                          : AppColors.textDarkSub,
                    )),
                const Spacer(),
                Text('${all.length} total',
                    style: TextStyle(
                      fontSize: 10,
                      color: isDark
                          ? AppColors.textSecondary
                          : AppColors.textDarkSub,
                    )),
              ],
            ),
          ),
          const Divider(height: 1),
          if (visible.isEmpty)
            Padding(
              padding: const EdgeInsets.all(16),
              child: Text('No pings yet',
                  style: TextStyle(
                    fontSize: 13,
                    color: isDark
                        ? AppColors.textSecondary
                        : AppColors.textDarkSub,
                  )),
            )
          else
            ListView.separated(
              controller: _scroll,
              shrinkWrap: true,
              physics: const NeverScrollableScrollPhysics(),
              itemCount: visible.length,
              separatorBuilder: (_, __) =>
                  Divider(height: 1, color: isDark
                      ? AppColors.bgCardBorder.withOpacity(0.5)
                      : AppColors.bgLightBorder),
              itemBuilder: (_, i) =>
                  _PingRow(result: visible[i], isDark: isDark),
            ),
        ],
      ),
    );
  }
}

class _PingRow extends StatelessWidget {
  final PingResult result;
  final bool isDark;

  const _PingRow({required this.result, required this.isDark});

  Color _latencyColor(int ms) {
    if (ms <= 50) return AppColors.excellent;
    if (ms <= 100) return AppColors.good;
    if (ms <= 200) return AppColors.fair;
    return AppColors.poor;
  }

  @override
  Widget build(BuildContext context) {
    final timeStr = DateFormat('HH:mm:ss').format(result.timestamp);
    final color =
        result.success ? _latencyColor(result.latency) : AppColors.offline;

    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 8),
      child: Row(
        children: [
          // Time
          Text(timeStr,
              style: TextStyle(
                fontSize: 11,
                color:
                    isDark ? AppColors.textSecondary : AppColors.textDarkSub,
                fontFeatures: const [FontFeature.tabularFigures()],
              )),
          const SizedBox(width: 10),
          // Dot
          Container(
            width: 6,
            height: 6,
            decoration:
                BoxDecoration(shape: BoxShape.circle, color: color),
          ),
          const SizedBox(width: 8),
          // Status
          Expanded(
            child: Text(
              result.success ? 'Reply received' : (result.error ?? 'Timeout'),
              style: TextStyle(
                fontSize: 12,
                color: isDark ? AppColors.textPrimary : AppColors.textDark,
              ),
              overflow: TextOverflow.ellipsis,
            ),
          ),
          // Badge
          Container(
            padding:
                const EdgeInsets.symmetric(horizontal: 8, vertical: 3),
            decoration: BoxDecoration(
              color: color.withOpacity(0.12),
              borderRadius: BorderRadius.circular(6),
            ),
            child: Text(
              result.success ? '${result.latency}ms' : '—',
              style: TextStyle(
                fontSize: 11,
                fontWeight: FontWeight.w700,
                color: color,
                fontFeatures: const [FontFeature.tabularFigures()],
              ),
            ),
          ),
        ],
      ),
    );
  }
}
